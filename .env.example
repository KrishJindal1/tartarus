# Frontend Environment Variables
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Backend Environment Variables
ENVIRONMENT=development
JWT_SECRET=replace-with-a-random-32+-char-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480
AUTH_ENABLED=false
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Database & Supabase (SQLite is used when SUPABASE_URL is empty)
DATABASE_PATH=jockey.db
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@YOUR_PROJECT.supabase.co:5432/postgres
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Seeded console account (dev bootstrap)
SEED_ADMIN_EMAIL=admin@jockey.local
SEED_ADMIN_PASSWORD=Jockey#Admin1

# Cloudflare R2 Storage (optional - inline payload delivery when empty)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=jocky-payloads
R2_ENDPOINT_URL=

# Cloudflare Worker Shared Secret
WORKER_SECRET=worker_shared_secret_32chars

# ML Service URL
ML_SERVICE_URL=http://127.0.0.1:8001
